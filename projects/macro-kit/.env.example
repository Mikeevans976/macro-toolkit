# Copy to projects/macro-kit/.env or backend/.env (both gitignored), or export
# the variables. Loaded by backend/settings.py; real environment variables win.

# dev (default) | prod. In prod the app refuses to start without SECRET_KEY.
MACROKIT_ENV=dev

# JWT signing key, 32+ characters. REQUIRED in prod.
# In dev, if unset, a key is generated once and kept in var/dev_secret_key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Seed an admin on first start if var/users.json does not exist
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

# Browser origins allowed to call the API (comma-separated). Default: local Vite dev servers.
# CORS_ORIGINS=https://analytics.example.com

# csv (default, simulated data) | simulation | bloomberg | haver
ANALYTICS_DATA_SOURCE=csv
# Haver DLX database path (haver source only)
# HAVER_PATH=

# Failed-login limit: after this many failures per IP or per username within the
# window (seconds), further attempts get HTTP 429 until the window passes.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300

# Warm the Fair Value Models cache in the background at startup (set 0 while iterating with --reload)
PRECOMPUTE_ON_STARTUP=1

LOG_LEVEL=INFO
PORT=8000

# Runtime state dir (SQLite DBs, users.json, pod sandbox, dev secret). Default: <project>/var
# MACROKIT_STATE_DIR=/srv/macrokit-state

# Global Macro Pod (backend/pod)
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
