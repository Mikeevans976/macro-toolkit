# Copy to .env (gitignored) or export before starting the backend.

# JWT signing key. REQUIRED for any shared/deployed instance; without it a random
# per-process key is used and every restart logs everyone out.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Seed an admin on first start if var/users.json does not exist
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

# csv (default, simulated data) | bloomberg | haver
ANALYTICS_DATA_SOURCE=csv

# Warm the Fair Value Models cache in the background at startup (set 0 while iterating with --reload)
PRECOMPUTE_ON_STARTUP=1

LOG_LEVEL=INFO
PORT=8000

# Runtime state dir (SQLite DBs, users.json, pod sandbox). Default: <project>/var
# MACROKIT_STATE_DIR=/srv/macrokit-state
