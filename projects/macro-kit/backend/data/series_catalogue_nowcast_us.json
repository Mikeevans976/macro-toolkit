{
  "_meta": {
    "description": "US GDP nowcast panel (Quant Macro, us-gdp): the indicators of the New York Fed Staff Nowcast (Bok, Caratelli, Giannone, Sbordone and Tambalotti, 2018) and the Atlanta Fed's GDPNow, in a Bańbura-Modugno mixed-frequency DFM with Global + Soft/Real/Labour blocks. The target is real GDP, % q/q saar, observed in the last month of each quarter.",
    "data_status": "Simulated until the live pipeline is connected. Bloomberg tickers are best guesses and must be checked on the Terminal (python scripts/probe_catalogue.py data/series_catalogue_nowcast_us.json); 'fred' gives the FRED/ALFRED series for a key-based pipeline (ALFRED has every vintage).",
    "field_reference": {
      "frequency": "M (default) or Q: quarterly series are observed in the last month of the quarter and enter the model through the triangle aggregation",
      "transform": "applied to the Bloomberg ticker's values: none (already a growth rate / balance), diff, log_diff (% change)",
      "release_lag_days": "typical days from the end of the reference period to the first release (negative: released before the period ends, e.g. regional surveys)",
      "vintages": "settle_days / sim_sd: how long revisions run and their size in the simulation",
      "sim": "simulation DGP: mean, loading on the common factor, noise, AR(1) of the noise"
    }
  },
