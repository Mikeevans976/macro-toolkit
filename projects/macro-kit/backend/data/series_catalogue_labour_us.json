{
  "_meta": {
    "description": "Indicators of US employment growth for the US Labour Market Nowcast (labour_nowcast.py): the same two-step dynamic factor model as the UK tool (Doz, Giannone and Reichlin, 2011), its common component scaled to nonfarm payroll growth (3m/3m) over 2000-19. The Fed publishes no such measure; the comparison is the FOMC statement and the SEP unemployment projection.",
    "data_status": "Simulated until the live pipeline is connected. Bloomberg tickers marked here are best guesses to check on the Terminal (python scripts/probe_catalogue.py data/series_catalogue_labour_us.json); null = not set. 'fred' gives the FRED series for a key-based pipeline.",
    "start": "2000-01",
    "scale_window": ["2000-01", "2019-12"],
    "exclude": [["2020-03", "2021-06"]],
    "field_reference": {
      "source": "bloomberg (or fred once the pipeline is connected); simulation otherwise",
      "transform": "level, or growth3 (% change on three months earlier)",
      "factor": "true: enters the factor model; false: target, unemployment-rate inputs, real wages"
    }
  },
  "series": [
    {"id": "payrolls", "name": "Nonfarm payrolls", "short": "Payrolls", "group": "Official data", "source": "bloomberg",
     "transform": "growth3", "factor": false, "ticker_bloomberg": "NFP T Index", "fred": "PAYEMS", "units": "000s",
     "notes": "BLS establishment survey, level. The target: underlying growth is scaled to its 3m/3m growth."},
    {"id": "household_employment", "name": "Household survey employment", "short": "HH employment", "group": "Official data", "source": "bloomberg",
     "transform": "level", "factor": false, "ticker_bloomberg": null, "fred": "CE16OV", "units": "000s",
     "notes": "Current Population Survey; with the labour force gives the unemployment rate."},
    {"id": "labour_force", "name": "Civilian labour force", "short": "Labour force", "group": "Official data", "source": "bloomberg",
     "transform": "level", "factor": false, "ticker_bloomberg": null, "fred": "CLF16OV", "units": "000s", "notes": ""},
    {"id": "unemployment_rate", "name": "Unemployment rate", "short": "Unemp. rate", "group": "Official data", "source": "bloomberg",
     "transform": "level", "factor": false, "ticker_bloomberg": "USURTOT Index", "fred": "UNRATE", "units": "%", "notes": ""},
    {"id": "real_ahe", "name": "Real average hourly earnings", "short": "Real AHE", "group": "Official data", "source": "bloomberg",
     "transform": "level", "factor": false, "ticker_bloomberg": null, "fred": "CES0500000003 / CPIAUCSL", "units": "index",
     "notes": "Average hourly earnings, private, deflated by CPI: the real-wage side of the demand/supply SVAR."},
    {"id": "claims_initial", "name": "Initial jobless claims", "short": "Initial claims", "group": "Official data", "source": "bloomberg",
     "transform": "growth3", "factor": true, "ticker_bloomberg": "INJCJC Index", "fred": "ICSA", "units": "% 3m/3m",
     "notes": "Weekly; monthly value is the month's last week. Loads negatively."},
    {"id": "claims_continuing", "name": "Continuing claims", "short": "Cont. claims", "group": "Official data", "source": "bloomberg",
     "transform": "growth3", "factor": true, "ticker_bloomberg": "INJCSP Index", "fred": "CCSA", "units": "% 3m/3m", "notes": "Loads negatively."},
    {"id": "jolts_openings", "name": "JOLTS job openings", "short": "Openings", "group": "Official data", "source": "bloomberg",
     "transform": "growth3", "factor": true, "ticker_bloomberg": "JOLTTOTL Index", "fred": "JTSJOL", "units": "% 3m/3m", "notes": "From December 2000."},
    {"id": "jolts_quits", "name": "JOLTS quits rate", "short": "Quits rate", "group": "Official data", "source": "bloomberg",
     "transform": "level", "factor": true, "ticker_bloomberg": null, "fred": "JTSQUR", "units": "%", "notes": ""},
    {"id": "jolts_hires", "name": "JOLTS hires rate", "short": "Hires rate", "group": "Official data", "source": "bloomberg",
     "transform": "level", "factor": true, "ticker_bloomberg": null, "fred": "JTSHIR", "units": "%", "notes": ""},
    {"id": "adp", "name": "ADP private employment", "short": "ADP", "group": "Private surveys", "source": "bloomberg",
     "transform": "growth3", "factor": true, "ticker_bloomberg": null, "fred": "ADPMNUSNERSA", "units": "% 3m/3m", "notes": "ADP National Employment Report, level."},
    {"id": "ism_mfg_employment", "name": "ISM manufacturing: employment", "short": "ISM mfg empl.", "group": "Private surveys", "source": "bloomberg",
     "transform": "level", "factor": true, "ticker_bloomberg": "NAPMEMPL Index", "fred": null, "units": "index (50 = no change)", "notes": "Proprietary."},
    {"id": "ism_services_employment", "name": "ISM services: employment", "short": "ISM serv. empl.", "group": "Private surveys", "source": "bloomberg",
     "transform": "level", "factor": true, "ticker_bloomberg": null, "fred": null, "units": "index (50 = no change)", "notes": "Proprietary."},
    {"id": "labour_differential", "name": "Conference Board labour differential", "short": "Jobs plentiful − hard", "group": "Private surveys", "source": "bloomberg",
     "transform": "level", "factor": true, "ticker_bloomberg": null, "fred": null, "units": "pp",
     "notes": "Jobs 'plentiful' minus 'hard to get' (consumer confidence survey); proprietary."},
    {"id": "nfib_hiring", "name": "NFIB hiring plans", "short": "NFIB hiring", "group": "Private surveys", "source": "bloomberg",
     "transform": "level", "factor": true, "ticker_bloomberg": null, "fred": null, "units": "net %", "notes": "Small-business survey."},
    {"id": "philly_employment", "name": "Philadelphia Fed: employment", "short": "Philly empl.", "group": "Fed surveys", "source": "bloomberg",
     "transform": "level", "factor": true, "ticker_bloomberg": null, "fred": "NECDFSA066MSFRBPHI", "units": "diffusion index", "notes": "Released in the reference month."},
    {"id": "empire_employment", "name": "Empire State: employment", "short": "Empire empl.", "group": "Fed surveys", "source": "bloomberg",
     "transform": "level", "factor": true, "ticker_bloomberg": null, "fred": "NEDFSA066MSFRBNY", "units": "diffusion index", "notes": "From July 2001."}
  ]
}
