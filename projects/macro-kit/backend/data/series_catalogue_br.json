  "_meta": {
    "description": "Brazil series catalogue for the Brazil Macro Heatmap (EM). 23 DFM series in 4 groups (Growth, Inflation, Employment, Wages), 6 NTN-F BVAL yields. Every ticker probed on the Bloomberg Terminal on 2026-10-18.",
    "field_reference": {
      "id": "Unique machine-readable slug. Used to cross-reference series across tools and config files.",
      "name": "Human-readable short label.",
      "description": "What the series measures and why it matters.",
      "source": "Data vendor: bloomberg | haver | ecb | eurostat | derived.",
      "ticker_bloomberg": "Bloomberg ticker string (e.g. 'PMITUKG Index'). null if not available on Bloomberg.",
      "ticker_haver": "Haver mnemonic (e.g. 'PMIUKCO@EMERGE'). null if not available on Haver.",
      "frequency": "Observation frequency: daily | monthly | quarterly.",
      "units": "Unit/scale of the raw series as pulled from source.",
      "typical_lag_days": "Calendar days from reference period end to typical publication date. null for daily market data (no publication lag).",
      "asset_class": "Grouping: macro_survey | macro_activity | macro_inflation | macro_labour | government_bonds | rates_swaps | inflation_swaps | commodities | volatility.",
      "geography": "Primary geographic scope of the series.",
      "tools": "List of tool IDs in the hub that consume this series.",
      "role": "How the series is used: factor_input (DFM macro block) | target (y-variable in regression model) | predictor (x-variable) | market_data (general market series).",
      "dfm_factor": "For factor_input series: which DFM factor this series primarily identifies (Growth | Inflation | Employment | Wages). Housing series are assigned Growth.",
      "dfm_sign": "For factor_input series: +1 if series moves in the same direction as the factor, -1 if inverse (e.g. unemployment rate is -1 for Employment factor).",
      "dfm_col_index": "Zero-based column index in the DFM observation matrix Y_daily. Must be contiguous 0-47.",
      "dfm_primary": "True for exactly one series per factor group — the sign-anchor series used for PCA orientation.",
      "heatmap_group": "Display grouping label used in the UK heatmap UI.",
      "notes": "Free-text caveats, data quirks, or ingestion instructions.",
      "transform": "Optional transform applied after fetching, before the DFM: yoy (% change on a year earlier) | diff_yoy (change on a year earlier) | sum12 (trailing 12-month sum of a monthly flow). Absent/none = use the series as published."
    }
