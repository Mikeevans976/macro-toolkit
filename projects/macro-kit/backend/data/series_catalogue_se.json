      "ticker_haver": "Haver mnemonic (e.g. 'PMIUKCO@EMERGE'). null if not available on Haver.",
      "frequency": "Observation frequency: daily | monthly | quarterly.",
      "units": "Unit/scale of the raw series as pulled from source.",
      "typical_lag_days": "Calendar days from reference period end to typical publication date. null for daily market data (no publication lag).",
      "asset_class": "Grouping: macro_survey | macro_activity | macro_inflation | macro_labour | government_bonds | rates_swaps | inflation_swaps | commodities | volatility.",
      "geography": "Primary geographic scope of the series.",
      "tools": "List of tool IDs in the hub that consume this series.",
      "role": "How the series is used: factor_input (DFM macro block) | target (y-variable in regression model) | predictor (x-variable) | market_data (general market series).",
