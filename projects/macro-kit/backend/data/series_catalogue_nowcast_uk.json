{
  "_meta": {
    "description": "Panel for the UK GDP nowcast (Quant Macro). Monthly GDP m/m is the target; quarterly GDP q/q is its 3m-on-3m aggregate. Blocks follow the NY Fed / Banbura-Modugno layout: every series loads on Global, plus one of Soft (surveys), Real (activity, housing) or Labour.",
    "tickers_verified": "Not yet. Every ticker was found with the Bloomberg instrument search on 2026-10-19, but history could not be pulled (Terminal returned LIMIT / WORKFLOW_REVIEW_NEEDED). Run `python scripts/probe_catalogue.py data/series_catalogue_nowcast_uk.json` once access is back.",
    "field_reference": {
      "id": "Column name in the model panel.",
      "group": "Display group (Activity, Surveys, Labour, Housing & credit); news is aggregated by group.",
      "blocks": "Factor blocks the series loads on.",
      "transform": "Applied to the raw Bloomberg series: none | diff (first difference) | log_diff (100 x log change).",
      "release_lag_days": "Calendar days from the end of the reference month to publication (negative = flash released inside the month). Used to build pseudo-real-time vintages when Bloomberg release dates are unavailable, and for the simulated calendar.",
      "start": "First month with data (for the simulation; live data start where Bloomberg history starts).",
      "sim": "Simulated DGP in transformed units: x = mean + load * global + 0.4 * |load| * block + noise * AR(1)(rho) idiosyncratic."
    }
  },
